NUXT_DASHSCOPE_API_KEY=sk-your-api-key
NUXT_DASHSCOPE_WORKSPACE_ID=your-workspace-id
NUXT_DASHSCOPE_REGION=cn-beijing
# 可选：覆盖完整 API 基础地址，例如 https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1
NUXT_DASHSCOPE_BASE_URL=
NUXT_DASHSCOPE_MODEL=wan3.0-video-prime

# MiniMax（可选）
NUXT_MINIMAX_API_KEY=
NUXT_MINIMAX_GROUP_ID=
NUXT_MINIMAX_BASE_URL=

# 可灵 Kling（可选）
NUXT_KLING_ACCESS_KEY=
NUXT_KLING_SECRET_KEY=
NUXT_KLING_BASE_URL=

# Seedance / 火山方舟（可选）
NUXT_SEEDANCE_API_KEY=
NUXT_SEEDANCE_BASE_URL=
NUXT_SEEDANCE_MODEL=doubao-seedance-1-5-pro-251215

# RollDek WAN 3.0（可选）
NUXT_ROLLDEK_API_KEY=
NUXT_ROLLDEK_BASE_URL=https://rolldek.com

# Runway Dev（可选）
NUXT_RUNWAY_API_KEY=
NUXT_RUNWAY_BASE_URL=https://api.dev.runwayml.com
NUXT_RUNWAY_MODEL=gen4.5

# 生产数据与任务基础设施（必填）
NUXT_DATABASE_URL=postgresql://forkvdo:change-me@postgres:5432/forkvdo
NUXT_REDIS_URL=redis://redis:6379
# 留空时开发环境使用 inline，生产环境使用 redis
NUXT_QUEUE_MODE=
NUXT_WORKER_ENABLED=false
NUXT_WORKER_CONCURRENCY=4
# 注册模式：invite / open / disabled
NUXT_REGISTRATION_MODE=invite
NUXT_SIGNUP_CREDITS=0
NUXT_USER_MAX_ACTIVE_GENERATIONS=3
NUXT_PLATFORM_DAILY_CREDIT_BUDGET=100000

# 阿里云 OSS（可选；配置完整后输入素材和生成结果会自动转存到 OSS）
NUXT_OSS_ACCESS_KEY_ID=
NUXT_OSS_ACCESS_KEY_SECRET=
NUXT_OSS_BUCKET=
NUXT_OSS_REGION=cn-beijing
# 可选：OSS API 接入点或内网上传地址，例如 https://oss-cn-beijing.aliyuncs.com
NUXT_OSS_ENDPOINT=
# 可选：OSS 自定义域名 / 公网访问基地址；使用内网 Endpoint 时必须填写
NUXT_OSS_PUBLIC_BASE_URL=
NUXT_OSS_PREFIX=forkvdo/uploads
NUXT_OSS_OUTPUT_PREFIX=forkvdo/outputs
NUXT_OSS_MAX_OUTPUT_BYTES=1073741824
NUXT_OSS_TRANSFER_TIMEOUT_MS=300000
# 供应商读取私有素材的签名链接有效期（秒）
NUXT_OSS_SIGNED_URL_TTL_SECONDS=86400

# ComfyUI 工作流模块（可选；详见 docs/development.md）
# 接入模式：auto / local / remote。auto 下若设置了 REMOTE_BASE_URL 则走 remote，否则 local
NUXT_COMFYUI_MODE=auto
# 生产环境必须设置为 remote，并配置 REMOTE_BASE_URL；auto/local 仅用于开发
# 本地模式：仓库目录。默认 ./vendor/ComfyUI，运行时按需 clone
NUXT_COMFYUI_DIR=
# 本地模式：python 解释器，默认优先仓库内 .venv/bin/python，其次 uv，最后 python3
NUXT_COMFYUI_PYTHON=
# 本地模式：监听地址 / 端口
NUXT_COMFYUI_HOST=127.0.0.1
NUXT_COMFYUI_PORT=8188
# 追加到 `python main.py` 之后的额外参数
NUXT_COMFYUI_ARGS=
# remote 模式：已运行 ComfyUI 的基地址，例如 http://192.168.1.20:8188
NUXT_COMFYUI_REMOTE_BASE_URL=
# 本地模式就绪探测超时（毫秒），首次启动加载模型时建议放大
NUXT_COMFYUI_START_TIMEOUT_MS=180000
# 状态轮询 / /system_stats 探测超时（毫秒）
NUXT_COMFYUI_PROBE_TIMEOUT_MS=1500

NUXT_PUBLIC_APP_URL=http://localhost:3000
