# 本机基础设施；视频/文本连接与运营设置在 /admin/settings 维护。
POSTGRES_PASSWORD=change-me-local-only
NUXT_DATABASE_URL=postgresql://forkvdo:change-me-local-only@127.0.0.1:55432/forkvdo
# 必填：32 字节随机值的 Base64；首次旧配置导入可自动生成并私密保存。
NUXT_CONNECTION_ENCRYPTION_KEY=
NUXT_WORKER_ENABLED=true
NUXT_PUBLIC_APP_URL=http://localhost:3000

# 本地对象存储。两组凭据分别供容器初始化与应用访问，必须一致。
LOCAL_OSS_ACCESS_KEY_ID=forkvdo-local
LOCAL_OSS_ACCESS_KEY_SECRET=change-me-local-storage
NUXT_OSS_ACCESS_KEY_ID=forkvdo-local
NUXT_OSS_ACCESS_KEY_SECRET=change-me-local-storage
NUXT_OSS_BUCKET=forkvdo
NUXT_OSS_REGION=us-east-1
NUXT_OSS_ENDPOINT=http://127.0.0.1:9100
NUXT_OSS_SECURE=false

# 可选的管理员工作流；高级参数和执行端连接见 docs/configuration.md。
NUXT_COMFYUI_MODE=local
