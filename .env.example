# 本机基础设施；文本/图片/视频 连接与运营设置在 /admin/settings 维护。
POSTGRES_DB=huezumi
POSTGRES_USER=huezumi
POSTGRES_PASSWORD=change-me-local-only
NUXT_DATABASE_URL=postgresql://huezumi:change-me-local-only@127.0.0.1:55432/huezumi
# 必填：32 字节随机值的 Base64；首次旧配置导入可自动生成并私密保存。
NUXT_CONNECTION_ENCRYPTION_KEY=
NUXT_WORKER_ENABLED=true
NUXT_PUBLIC_APP_URL=http://localhost:3000

# 本地对象存储。两组凭据分别供容器初始化与应用访问，必须一致。
LOCAL_OSS_BUCKET=huezumi
LOCAL_OSS_ACCESS_KEY_ID=huezumi-local
LOCAL_OSS_ACCESS_KEY_SECRET=change-me-local-storage
NUXT_OSS_ACCESS_KEY_ID=huezumi-local
NUXT_OSS_ACCESS_KEY_SECRET=change-me-local-storage
NUXT_OSS_BUCKET=huezumi
NUXT_OSS_REGION=us-east-1
NUXT_OSS_ENDPOINT=http://127.0.0.1:9100
NUXT_OSS_SECURE=false

# 本地 ComfyUI：先运行 pnpm comfy:install；随 Nuxt 启动，管理员可在工作流页面启停。
NUXT_COMFY_MANAGED=true
NUXT_COMFY_AUTO_START=true
NUXT_COMFY_DIRECTORY=vendor/ComfyUI
NUXT_COMFY_PORT=8188
NUXT_COMFY_CPU=false
# 留空使用 ComfyUI/.venv 的 Python；服务连接和模型/节点策略存于数据库。
NUXT_COMFY_PYTHON=
