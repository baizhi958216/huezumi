# 复制到部署目录 .env，填写部署凭据；模型连接在管理后台配置。
POSTGRES_DB=huezumi
POSTGRES_USER=huezumi
POSTGRES_PASSWORD=
NUXT_CONNECTION_ENCRYPTION_KEY=
NUXT_PUBLIC_APP_URL=https://your-app.example.com
NUXT_OSS_ACCESS_KEY_ID=
NUXT_OSS_ACCESS_KEY_SECRET=
NUXT_OSS_BUCKET=
NUXT_OSS_REGION=cn-beijing
NUXT_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
NUXT_OSS_SECURE=true
NUXT_WORKER_CONCURRENCY=4
# 文本、图片、视频 的 API / Key 全部在 /admin/settings 配置。

# 生产使用独立 ComfyUI 服务，数据库连接地址需同时被 Web 和 worker 访问。
NUXT_COMFY_MANAGED=false
NUXT_COMFY_AUTO_START=false
